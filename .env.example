NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:8089
DATABASE_URL=postgresql://moneylens:local-development-only@localhost:5432/moneylens
JWT_SECRET=replace-with-at-least-32-random-characters
IDENTIFIER_HASH_KEY=replace-with-a-different-32-character-random-key
UPLOAD_MAX_MB=20
OCR_CONCURRENCY=2
OCR_DEADLINE_MS=120000
MISTRAL_API_KEY=
MISTRAL_ORGANIZATION_ID=
MISTRAL_MODEL=mistral-ocr-latest
MISTRAL_OCR_ENABLED=false
# Configure both for the self-hosted PaddleOCR service.
# PADDLE_OCR_URL=http://127.0.0.1:8080
# PADDLE_OCR_TOKEN=<shared token from openssl rand -hex 32>
# COMPOSE_PADDLE_OCR_URL=http://ocr:8080
# Set both limits at or below your Mistral account limits before enabling OCR.
# MISTRAL_OCR_REQUESTS_PER_SECOND=1
# MISTRAL_OCR_PAGES_PER_MINUTE=30
ZDR_EVIDENCE_PATH=/run/privacy/mistral.json
PROVIDER_EVIDENCE_PUBLIC_KEY_PATH=/run/privacy/approver.pub
JEV_API_KEY=
JEV_ORGANIZATION_ID=
JEV_MODEL=jev-latest
JEV_EVIDENCE_PATH=/run/privacy/jev.json
JEV_TIMEOUT_MS=15000
JEV_CONCURRENCY=4
SEMANTIC_AUTO_ACCEPT=false
AUTO_CLASSIFY_THRESHOLD=0.90
REQUIRE_REVIEW_THRESHOLD=0.75
JOBS_ENABLED=true

# Email verification and password reset (backend only)
# Set console only for local development to print codes without Resend.
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
RESEND_FROM=

# Aggregate financial insights (server only; production requires signed ZDR approval)
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
OPENAI_INSIGHTS_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EVIDENCE_PATH=/run/privacy/openai.json
INSIGHTS_DEADLINE_MS=45000
INSIGHTS_CONCURRENCY=4
INSIGHTS_REQUESTS_PER_HOUR=30
