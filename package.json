{
  "name": "moneylens-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "reclassify:unresolved": "node --env-file-if-exists=.env --import tsx scripts/reclassify-unresolved.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "format:check": "prettier --check src test scripts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "busboy": "^1.6.0",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfjs-dist": "^6.5.438",
    "pg-boss": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.1.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "railway": "^3.17.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "js-yaml": "5.5.0"
  }
}
